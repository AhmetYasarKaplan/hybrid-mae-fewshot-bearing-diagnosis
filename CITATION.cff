    given-names: "Ahmet Yaşar"
repository-code: "https://github.com/AhmetYasarKaplan/hybrid-mae-fewshot-bearing-diagnosis"
license: MIT
keywords:
  - bearing fault diagnosis
  - predictive maintenance
  - representation learning
  - self-supervised learning
  - few-shot learning
  - domain generalization
